{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../dist/types/tools",
    "tsBuildInfoFile": "../dist/types/tools/tsconfig.vite.tsbuildinfo",
    "types": ["node"],
    "rootDir": ".."
  },
  "include": [
    "../vite.config.ts",
    "../vite.debug.config.ts",
    "../content/puzzles.json",
    "../src/server/core/*.ts"
  ],
  "exclude": ["../src/server/core/*.test.ts"],
  "references": [
    {
      "path": "./tsconfig.shared.json"
    }
  ]
}
