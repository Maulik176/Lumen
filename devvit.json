{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "lumen-game",
  "marketingAssets": {
    "icon": "content/brand/png/app-icon-1024.png"
  },
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "preview.html",
        "height": "regular"
      },
      "game": {
        "entry": "game.html"
      },
      "howto": {
        "entry": "howto.html"
      },
      "builder": {
        "entry": "builder.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Post today's Lumen",
        "description": "Create the post for today's island",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-today"
      },
      {
        "label": "Post a Lumen island (testing)",
        "description": "Create a post for any day number",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-day"
      },
      {
        "label": "Reset my Lumen progress (dev)",
        "description": "Playtest subreddit only: forget my tutorial and today's solve",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/reset-me"
      },
      {
        "label": "Dev: set today to day N",
        "description": "Playtest subreddit only: move the server's clock to any day",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/set-today"
      },
      {
        "label": "Dev: clean up this subreddit",
        "description": "Playtest subreddit only: delete every Lumen post and reset all days",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/clean-up"
      },
      {
        "label": "Play the Lumen trailer (once)",
        "description": "For the demo video: the next time you open the game it plays itself",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/trailer"
      },
      {
        "label": "Dev: preview lantern styles",
        "description": "Playtest subreddit only: one lantern of each streak style in your sky for 30 minutes (tap again to turn off)",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/style-preview"
      }
    ]
  },
  "forms": {
    "postDay": "/internal/form/post-day",
    "setToday": "/internal/form/set-today"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onAppUpgrade": "/internal/triggers/on-app-upgrade"
  },
  "scripts": {
    "build": "vite build && tsx scripts/build-check.ts",
    "dev": "tsx scripts/dev-build.ts"
  },
  "dev": {
    "subreddit": "lumen_game_dev"
  },
  "permissions": {
    "redis": true,
    "journeys": true,
    "realtime": true,
    "reddit": {
      "enable": true,
      "asUser": ["SUBMIT_COMMENT", "SUBMIT_POST"]
    }
  },
  "scheduler": {
    "tasks": {
      "daily-post": {
        "endpoint": "/internal/scheduler/daily-post",
        "cron": "0 0 * * *"
      },
      "daily-catch-up": {
        "endpoint": "/internal/scheduler/daily-catch-up",
        "cron": "7,37 * * * *"
      }
    }
  }
}
