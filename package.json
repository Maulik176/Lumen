{
  "private": true,
  "name": "lumen-game",
  "version": "0.0.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "bench": "vitest run --config vitest.bench.config.ts",
    "build": "vite build && tsx scripts/build-check.ts",
    "check:build": "tsx scripts/build-check.ts",
    "checks": "bash scripts/checks.sh",
    "debug": "vite --config vite.debug.config.ts",
    "dev": "tsx scripts/live-guard.ts && devvit playtest",
    "gen": "tsx scripts/gen.ts",
    "hero": "node scripts/hero.mjs",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "login": "devvit login",
    "prettier": "prettier --write .",
    "release": "bash scripts/release.sh",
    "report": "tsx scripts/report.ts",
    "seats": "node scripts/seats.mjs",
    "sunday-pass": "node scripts/sunday-pass.mjs",
    "test": "vitest run",
    "test:scale": "vitest run src/server/core/accounted-scale.test.ts src/server/core/shelf.test.ts src/server/core/sunday.test.ts",
    "test:types": "tsc --build",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@devvit/analytics": "0.15.2",
    "@devvit/start": "0.15.2",
    "@devvit/web": "0.15.2",
    "@hono/node-server": "2.1.6",
    "devvit": "0.15.2",
    "hono": "4.13.17",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.13.3",
    "@types/three": "^0.187.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.7",
    "vitest": "^5.1.0"
  }
}
