{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "lumen-game",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "preview.html",
        "height": "regular"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Post today's Lumen",
        "description": "Create the post for today's island",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-today"
      },
      {
        "label": "Post a Lumen island (testing)",
        "description": "Create a post for any day number",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-day"
      }
    ]
  },
  "forms": {
    "postDay": "/internal/form/post-day"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onAppUpgrade": "/internal/triggers/on-app-upgrade"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "dev": {
    "subreddit": "lumen_game_dev"
  },
  "permissions": {
    "redis": true
  }
}
