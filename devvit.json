{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "lumen-game",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "preview.html",
        "height": "regular"
      },
      "game": {
        "entry": "game.html"
      },
      "howto": {
        "entry": "howto.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Post today's Lumen",
        "description": "Create the post for today's island",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-today"
      },
      {
        "label": "Post a Lumen island (testing)",
        "description": "Create a post for any day number",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-day"
      },
      {
        "label": "Reset my Lumen progress (dev)",
        "description": "Playtest subreddit only: forget my tutorial and today's solve",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/reset-me"
      }
    ]
  },
  "forms": {
    "postDay": "/internal/form/post-day"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onAppUpgrade": "/internal/triggers/on-app-upgrade"
  },
  "scripts": {
    "build": "vite build && tsx scripts/build-check.ts",
    "dev": "tsx scripts/dev-build.ts"
  },
  "dev": {
    "subreddit": "lumen_game_dev"
  },
  "permissions": {
    "redis": true,
    "realtime": true,
    "reddit": {
      "enable": true,
      "asUser": ["SUBMIT_COMMENT"]
    }
  },
  "scheduler": {
    "tasks": {
      "daily-post": {
        "endpoint": "/internal/scheduler/daily-post",
        "cron": "0 0 * * *"
      },
      "daily-catch-up": {
        "endpoint": "/internal/scheduler/daily-catch-up",
        "cron": "7,37 * * * *"
      }
    }
  }
}
